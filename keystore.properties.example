# Copy to keystore.properties and fill in with your own key. The real file is gitignored.
# CI uses the same four values from repository secrets:
#   KEYSTORE_BASE64 (base64 of the .jks), KEYSTORE_PASSWORD, KEY_ALIAS, KEY_PASSWORD
storeFile=brainstorm-upload.jks
storePassword=change-me
keyAlias=brainstorm
keyPassword=change-me
