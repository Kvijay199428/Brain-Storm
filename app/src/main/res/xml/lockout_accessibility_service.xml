<?xml version="1.0" encoding="utf-8"?>
<!--
  Opt-in, best-effort PiP / restricted-window detection. No package filter: the service checks the
  lockout database itself so the monitored set can grow after setup. It never reads window text.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagRetrieveInteractiveWindows"
    android:canRetrieveWindowContent="false"
    android:description="@string/lockout_service_description"
    android:notificationTimeout="300"
    android:settingsActivity="com.vegasol.brainstorm.MainActivity" />
