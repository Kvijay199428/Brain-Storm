<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive-icon foreground: Brainy, drawn as a vector so every density stays crisp and the APK
  stays small. The artwork sits inside the 66dp safe circle of the 108dp canvas (x/y 21..87),
  so no system mask can clip the face.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Brain silhouette: soft scalloped lobes. -->
    <path
        android:fillColor="#FFB8D6"
        android:pathData="M54,32
            A10,10 0 0 1 64,36
            A10,10 0 0 1 74,44
            A9,9 0 0 1 78,54
            A9,9 0 0 1 70,66
            A9,9 0 0 1 58,74
            A8,8 0 0 1 50,74
            A9,9 0 0 1 38,66
            A9,9 0 0 1 30,54
            A9,9 0 0 1 34,44
            A10,10 0 0 1 44,36
            A10,10 0 0 1 54,32
            Z" />

    <!-- Central fissure and two folds: enough texture to read as a brain, not a cloud.
         The crease stops above the eyes so it never runs into the smile. -->
    <path
        android:strokeColor="#D9739F"
        android:strokeWidth="2.4"
        android:strokeLineCap="round"
        android:pathData="M54,35 C52,40 56,44 54,49" />
    <path
        android:strokeColor="#D9739F"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:pathData="M42,41 C45,42 46,45 45,48" />
    <path
        android:strokeColor="#D9739F"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:pathData="M66,41 C63,42 62,45 63,48" />

    <!-- Face: two round eyes with a catchlight, and a small smile. -->
    <path
        android:fillColor="#2A1A4A"
        android:pathData="M45,58.5m-3.4,0a3.4,3.4 0,1 1,6.8 0a3.4,3.4 0,1 1,-6.8 0" />
    <path
        android:fillColor="#2A1A4A"
        android:pathData="M63,58.5m-3.4,0a3.4,3.4 0,1 1,6.8 0a3.4,3.4 0,1 1,-6.8 0" />
    <path
        android:fillColor="#B8E3FF"
        android:pathData="M44.2,57.2m-1.1,0a1.1,1.1 0,1 1,2.2 0a1.1,1.1 0,1 1,-2.2 0" />
    <path
        android:fillColor="#B8E3FF"
        android:pathData="M62.2,57.2m-1.1,0a1.1,1.1 0,1 1,2.2 0a1.1,1.1 0,1 1,-2.2 0" />
    <path
        android:strokeColor="#2A1A4A"
        android:strokeWidth="2.2"
        android:strokeLineCap="round"
        android:pathData="M49,66 Q54,70 59,66" />
</vector>
