<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive launcher icon (minSdk 29, so every supported device uses this). Both layers are vectors,
  so every density stays crisp and the APK stays small. The mascot is drawn inside the 66dp safe
  circle of the 108dp canvas, so no system mask clips the face.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <!-- Lets Android 13+ themed icons render the app in the user's wallpaper palette. -->
    <monochrome android:drawable="@drawable/ic_notification" />
</adaptive-icon>
