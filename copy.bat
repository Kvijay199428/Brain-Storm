@echo off
setlocal EnableExtensions EnableDelayedExpansion

rem ---------------------------------------------------------------------------
rem  Brain Storm - export the tracked source tree into one markdown file.
rem
rem    copy.bat        every tracked text file, including the vendored three.js
rem    copy.bat lean   the same export without app/src/main/assets/three.min.js
rem
rem  The file list comes from "git ls-files", so build output, the screenshots
rem  and signing material can never end up in the export. Output is
rem  brain-storm.md in the repository root, which is gitignored.
rem
rem  This script is deliberately ASCII-only: "echo" writes in the console code
rem  page, so a stray dash or arrow in a heading would come out as mojibake.
rem  File bodies are copied with "type", which passes the UTF-8 bytes through
rem  untouched.
rem ---------------------------------------------------------------------------

cd /d "%~dp0"

set "OUT=brain-storm.md"
set "MODE=full"
if /i "%~1"=="lean" set "MODE=lean"

set "ALL=%TEMP%\brainstorm-all.txt"
set "LIST=%TEMP%\brainstorm-files.txt"
del "%ALL%" "%LIST%" "%LIST%.tmp" 2>nul

where git >nul 2>&1
if not errorlevel 1 (
    git rev-parse --is-inside-work-tree >nul 2>&1
    if not errorlevel 1 goto :git_collect
)

rem --- Fallback if git is missing or not a git repo --------------------------
powershell -NoProfile -ExecutionPolicy Bypass -Command ^
 "$exts = @('.kt','.kts','.xml','.md','.properties','.yml','.json','.svg','.html','.js','.ps1','.bat','.example','.pro','.gitignore','.gitattributes');" ^
 "Get-ChildItem -Recurse -File | Where-Object {" ^
 "  $p = $_.FullName.Replace('\', '/');" ^
 "  $p -notmatch '/(build|\.gradle|\.idea|\.kotlin|captures|\.cxx|dist|shots|app-update|tmp)/' -and" ^
 "  ($exts -contains $_.Extension.ToLower() -or $_.Name -eq 'gradlew') -and" ^
 "  $_.Name -ne 'brain-storm.md' -and $_.Name -ne 'copy.bat'" ^
 "} | ForEach-Object { Resolve-Path -Relative $_.FullName } | ForEach-Object { $_ -replace '^\.\\', '' -replace '\\', '/' } | Set-Content -Encoding Ascii '%LIST%'"
goto :after_collect

:git_collect
rem --- 1. collect ------------------------------------------------------------
git ls-files -c -o --exclude-standard *.kt *.kts *.xml *.md *.properties *.yml *.json *.svg *.html *.js *.ps1 *.bat *.example *.pro .gitignore .gitattributes gradlew > "%LIST%"

:after_collect
rem Exclude the generator script and the output markdown file themselves
findstr /v /i /c:"brain-storm.md" /c:"copy.bat" "%LIST%" > "%LIST%.tmp" 2>nul
if exist "%LIST%.tmp" move /y "%LIST%.tmp" "%LIST%" >nul

if /i "%MODE%"=="lean" (
    findstr /v /i /c:"three.min.js" "%LIST%" > "%LIST%.tmp" 2>nul
    if exist "%LIST%.tmp" move /y "%LIST%.tmp" "%LIST%" >nul
)

set "COUNT=0"
for /f "delims=" %%c in ('find /c /v "" ^< "%LIST%"') do set "COUNT=%%c"
if "%COUNT%"=="0" goto :nofiles

rem --- 2. provenance ---------------------------------------------------------
set "BRANCH="
for /f "delims=" %%b in ('git rev-parse --abbrev-ref HEAD 2^>nul') do set "BRANCH=%%b"
set "SHA="
for /f "delims=" %%s in ('git rev-parse --short HEAD 2^>nul') do set "SHA=%%s"
set "WHEN="
for /f "delims=" %%d in ('git log -1 --date=short --format=%%ad 2^>nul') do set "WHEN=%%d"
if not defined BRANCH set "BRANCH=unknown"
if not defined SHA set "SHA=unknown"
if not defined WHEN set "WHEN=%DATE%"

rem --- 3. header and contents ------------------------------------------------
> "%OUT%" echo # Brain Storm - complete source code
>>"%OUT%" echo.
>>"%OUT%" echo Generated by copy.bat from the git working tree.
>>"%OUT%" echo.
>>"%OUT%" echo - Branch: %BRANCH%
>>"%OUT%" echo - Commit: %SHA%
>>"%OUT%" echo - Date: %WHEN%
>>"%OUT%" echo - Files: %COUNT%
>>"%OUT%" echo - Mode: %MODE%
>>"%OUT%" echo.
>>"%OUT%" echo ## Contents
>>"%OUT%" echo.
for /f "usebackq delims=" %%f in ("%LIST%") do >>"%OUT%" echo - %%f
>>"%OUT%" echo.
>>"%OUT%" echo ## Omitted
>>"%OUT%" echo.
>>"%OUT%" echo Binary files are not exported: `gradle/wrapper/gradle-wrapper.jar` and the
>>"%OUT%" echo PNGs under `docs/store/`. Signing material (`keystore.properties`,
>>"%OUT%" echo `local.properties`, `*.jks`) is gitignored and never read by this script.
>>"%OUT%" echo The generator script (`copy.bat`) and the export file (`brain-storm.md`) are also excluded.
if /i "%MODE%"=="lean" (
    >>"%OUT%" echo.
    >>"%OUT%" echo `app/src/main/assets/three.min.js` is omitted in lean mode: it is a 603 KB
    >>"%OUT%" echo minified three.js build, not Brain Storm code.
)

rem --- 4. one section per file ----------------------------------------------
for /f "usebackq delims=" %%f in ("%LIST%") do (
    set "WIN=%%f"
    set "WIN=!WIN:/=\!"
    set "EXT=%%~xf"
    set "FENCE=```"
    set "LANG=text"
    if /i "!EXT!"==".kt" set "LANG=kotlin"
    if /i "!EXT!"==".kts" set "LANG=kotlin"
    if /i "!EXT!"==".xml" set "LANG=xml"
    if /i "!EXT!"==".svg" set "LANG=xml"
    if /i "!EXT!"==".md" set "LANG=markdown"
    if /i "!EXT!"==".properties" set "LANG=properties"
    if /i "!EXT!"==".example" set "LANG=properties"
    if /i "!EXT!"==".yml" set "LANG=yaml"
    if /i "!EXT!"==".json" set "LANG=json"
    if /i "!EXT!"==".js" set "LANG=javascript"
    if /i "!EXT!"==".html" set "LANG=html"
    if /i "!EXT!"==".ps1" set "LANG=powershell"
    if /i "!EXT!"==".bat" set "LANG=batch"
    rem README.md and the compliance docs contain fences of their own, so widen
    rem ours until it is longer than anything inside the file.
    findstr /l /c:"```" "!WIN!" >nul 2>&1
    if not errorlevel 1 set "FENCE=````"
    findstr /l /c:"````" "!WIN!" >nul 2>&1
    if not errorlevel 1 set "FENCE=`````"
    echo.>>"%OUT%"
    >>"%OUT%" echo ### %%f
    >>"%OUT%" echo ^<^^!-- path: %%f --^>
    >>"%OUT%" echo !FENCE!!LANG!
    type "!WIN!" >>"%OUT%"
    rem Schema JSON files have no trailing newline; this keeps the closing fence
    rem on its own line without touching the copied bytes.
    echo.>>"%OUT%"
    >>"%OUT%" echo !FENCE!
)

rem --- 5. summary ------------------------------------------------------------
for %%A in ("%OUT%") do set "BYTES=%%~zA"
set /a KB=BYTES/1024
echo.
echo Wrote %OUT% - %COUNT% files, %KB% KB
del "%ALL%" "%LIST%" "%LIST%.tmp" 2>nul
exit /b 0

:nofiles
echo.
echo No source files matched - is this the Brain Storm repository root?
del "%ALL%" "%LIST%" 2>nul
exit /b 1

:nogit
echo.
echo copy.bat must run inside the Brain Storm git repository with git on PATH.
echo It uses "git ls-files" so build output and signing material stay out of the export.
exit /b 1
